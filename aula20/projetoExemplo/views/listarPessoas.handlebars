<!DOCTYPE html>
<html>
<head>
    <title>Tela Listar Pessoas</title>
</head>
<body>
    <h1>Listar Pessoas</h1>

    <ul>
        {{#each pessoas}}
            <li>
                <a href="/pessoas/{{id}}">
                    {{nome}}
                </a>
                -
                <a href="/pessoas/{{id}}/editar">editar</a>

                <form action="/pessoas/{{id}}/excluir" 
                      method="post" 
                      style="display: inline;">
                    <button type="submit" 
                            onclick="return confirm('Confirma exclusão?')">
                        excluir
                    </button>
                </form>
            </li>
        {{/each}}
    </ul>

    <a href="/">Voltar</a>
</body>
</html>